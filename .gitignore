# Local runtime cache (see sync/README.md)
sync/*
!sync/README.md

# Per-project phase handovers (generated at runtime)
handover/*
!handover/README.md
!handover/.gitkeep

# Per-project kit lessons (captured at runtime; promoted via tasks/kit-review.md)
lessons/*
!lessons/README.md
!lessons/.gitkeep

# Machine-specific overrides (copy from config.example.json)
system/config.json

# gh skill provenance lock written when scanning project scope - do not commit
.skill-lock.json

# Upstream Agent Skills (install via `wk  sync` → ~/.cursor/skills)
# Only kit prefixes are committed: agent-*, profile-*, lang-*, framework-*
skills/*
!skills/README.md
!skills/external.lock.json
!skills/subagents.yaml
!skills/agent-*/
!skills/lang-*/
!skills/framework-*/
!skills/profile-*/

# Antigravity workspace MCP (written by wk mcp --project / wk init)
.agents/mcp_config.json

# Session MCP profile name (no secrets). Written by wk mcp --project / restore.
.wk-mcp-profile.stamp
.cursor/mcp-profile.stamp
.agents/mcp-profile.stamp

# Environment & secrets
.env
.env.*
!.env.example
!web/.env.example
*.pem
*.key
secrets.json
credentials.json
node_modules/
.pnpm-store/

# Astro docs app
web/dist/
web/.astro/
web/node_modules/

# Public GitHub Pages assemble output (repo root only; kit/src/site is source)
/site/

# EDD / eval report artifacts
out/

# TDD Guard session state (wk tdd-guard)
.waykit/tdd-guard/

# OS / editor
.DS_Store
*.swp
*.swo
ontology/index.json
assets/ontology-index.json
web/public/assets/ontology-index.json
