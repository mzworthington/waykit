---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteChrome from '../components/SiteChrome.astro';
import { HomeHero } from '../components/HomeHero.tsx';
import { HomeNext } from '../components/HomeNext.tsx';
import { DOCS_PAGES } from '../docs/pages.ts';
import { resolvePageSeo } from '../seo/siteSeo.ts';

const seo = resolvePageSeo('/');
const navPages = DOCS_PAGES.map(({ path, title }) => ({ path, title }));
---

<SiteLayout seo={seo}>
  <SiteChrome layout="landing" pathname="/" pages={navPages}>
    <div class="landing-page">
      <HomeHero />
      <HomeNext />
    </div>
  </SiteChrome>
</SiteLayout>
