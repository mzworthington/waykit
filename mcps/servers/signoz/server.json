{
  "id": "signoz",
  "name": "SigNoz",
  "summary": "Official SigNoz MCP for coding-agent tokens, cost, traces, logs, and alerts (stdio binary; Cloud instance URL or self-host).",
  "homepage": "https://signoz.io/docs/ai/signoz-mcp-server/",
  "transport": "stdio",
  "phases": ["telemetry", "debug"],
  "triggers": ["SigNoz", "OTLP", "gen_ai", "token usage", "agent cost", "coding-agent traces", "cloud agent traces"],
  "requiredEnv": ["SIGNOZ_URL", "SIGNOZ_API_KEY"],
  "mcp": {
    "signoz": {
      "command": "mise",
      "args": [
        "exec",
        "--cd",
        "${userHome}/.agents",
        "--",
        "signoz-mcp-server"
      ],
      "env": {
        "SIGNOZ_URL": "${env:SIGNOZ_URL}",
        "SIGNOZ_API_KEY": "${env:SIGNOZ_API_KEY}"
      }
    }
  }
}
